@@ -0,0 +1,40 @@
+extends SceneTree
+
+const MIN_SIZE := 64
+const MAX_SIZE := 4096
+const MAX_POSITION := 8192
+
+func _init() -> void:
+	var parsed := parse_args(OS.get_cmdline_user_args())
+	if parsed.has("error"):
+		push_error(String(parsed["error"]))
+		quit(2)
+		return
+	call_deferred("_launch", parsed)
+
+static func parse_args(args: PackedStringArray) -> Dictionary:
+	if args.size() != 5:
+		return { "error": "expected: <res://scene.tscn> <width> <height> <x> <y>" }
+	if not args[0].begins_with("res://") or not args[0].ends_with(".tscn"):
+		return { "error": "scene must be a res:// .tscn path" }
+	for value in args.slice(1):
+		if not value.is_valid_int():
+			return { "error": "size and position values must be integers" }
+	var width := args[1].to_int()
+	var height := args[2].to_int()
+	var x := args[3].to_int()
+	var y := args[4].to_int()
+	if width < MIN_SIZE or width > MAX_SIZE or height < MIN_SIZE or height > MAX_SIZE:
+		return { "error": "width and height must be between %d and %d" % [MIN_SIZE, MAX_SIZE] }
+	if abs(x) > MAX_POSITION or abs(y) > MAX_POSITION:
+		return { "error": "window position must be between -%d and %d" % [MAX_POSITION, MAX_POSITION] }
+	return { "scene": args[0], "size": Vector2i(width, height), "position": Vector2i(x, y) }
+
+func _launch(parsed: Dictionary) -> void:
+	DisplayServer.window_set_flag(DisplayServer.WINDOW_FLAG_BORDERLESS, true)
+	DisplayServer.window_set_size(parsed["size"])
+	DisplayServer.window_set_position(parsed["position"])
+	var err := change_scene_to_file(String(parsed["scene"]))
+	if err != OK:
+		push_error("could not launch scene: %s" % error_string(err))
+		quit(2)
