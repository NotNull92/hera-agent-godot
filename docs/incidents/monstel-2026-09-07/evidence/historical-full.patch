@@ -0,0 +1,94 @@
+#!/usr/bin/env -S uv run --script
+# /// script
+# requires-python = ">=3.11"
+# dependencies = []
+# ///
+
+# ─── How to run ───
+# 1. Install uv: curl -LsSf https://astral.sh/uv/install.sh | sh
+# 2. Run: uv run hera_pid_rpc.py --pid PID --path /absolute/output.png --analyze
+# ─────────────────
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import time
+import urllib.request
+from pathlib import Path
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--editor-pid", type=positive_int)
+    parser.add_argument("--pid", required=True, type=positive_int)
+    parser.add_argument("--timeout", type=bounded_timeout, default=5.0)
+    parser.add_argument("--path", required=True, type=absolute_path)
+    parser.add_argument("--analyze", action="store_true")
+    args = parser.parse_args()
+    instance = editor_instance(args.editor_pid)
+    payload = json.dumps({
+        "tool": "game",
+        "params": {"action": "screenshot", "pid": args.pid, "path": args.path, "analyze": args.analyze},
+    }).encode()
+    request = urllib.request.Request(
+        f"http://127.0.0.1:{instance['port']}/rpc",
+        data=payload,
+        headers={"Content-Type": "application/json", **token_header()},
+    )
+    with urllib.request.urlopen(request, timeout=args.timeout) as response:
+        result = json.load(response)
+    print(json.dumps(result, indent=2, sort_keys=True))
+    return 0 if result.get("ok") else 1
+
+
+def positive_int(value: str) -> int:
+    parsed = int(value)
+    if parsed <= 0:
+        raise argparse.ArgumentTypeError("PID must be positive")
+    return parsed
+
+
+def bounded_timeout(value: str) -> float:
+    parsed = float(value)
+    if not 0.1 <= parsed <= 10.0:
+        raise argparse.ArgumentTypeError("timeout must be between 0.1 and 10 seconds")
+    return parsed
+
+
+def absolute_path(value: str) -> str:
+    path = Path(value)
+    if not path.is_absolute():
+        raise argparse.ArgumentTypeError("screenshot path must be absolute")
+    return str(path)
+
+
+def editor_instance(editor_pid: int | None) -> dict[str, int | float | str]:
+    project = Path.cwd().resolve()
+    now = time.time()
+    matches = []
+    for path in (Path.home() / ".hera-agent-godot" / "instances").glob("*.json"):
+        try:
+            instance = json.loads(path.read_text())
+            same_editor = editor_pid is not None and int(instance["pid"]) == editor_pid
+            same_project = editor_pid is None and Path(instance["project_path"]).resolve() == project
+            if (same_editor or same_project) and now - float(instance["ts"]) <= 5:
+                matches.append(instance)
+        except (KeyError, OSError, TypeError, ValueError, json.JSONDecodeError):
+            continue
+    if len(matches) != 1:
+        raise SystemExit(f"expected one live Hera editor for {project}, found {len(matches)}")
+    return matches[0]
+
+
+def token_header() -> dict[str, str]:
+    token = os.environ.get("HERA_AGENT_GODOT_TOKEN", "").strip()
+    token_path = Path.home() / ".hera-agent-godot" / "token"
+    if not token and token_path.is_file():
+        token = token_path.read_text().strip()
+    return {"X-Hera-Token": token} if token else {}
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
