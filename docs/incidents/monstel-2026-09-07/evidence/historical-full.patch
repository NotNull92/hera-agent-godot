@@ -0,0 +1,200 @@
+#!/usr/bin/env -S uv run --script
+# /// script
+# requires-python = ">=3.11"
+# dependencies = []
+# ///
+
+# ─── How to run ───
+# 1. Install uv: curl -LsSf https://astral.sh/uv/install.sh | sh
+# 2. Run: tools/hera game --pid PID screenshot --path /absolute/output.png --analyze
+# ─────────────────
+
+from __future__ import annotations
+
+import json
+import os
+import subprocess
+import sys
+from pathlib import Path
+from typing import NoReturn
+
+
+def main() -> int:
+    real = real_hera()
+    global_args, command = split_global(sys.argv[1:])
+    if len(command) < 3 or command[0:2] != ["game", "--pid"]:
+        _ = os.execv(real, [real, *sys.argv[1:]])
+    pid = positive_int(command[2], "--pid")
+    params = game_params(command[3:])
+    params["pid"] = pid
+    batch_args = [arg for arg in global_args if arg != "--ids"]
+    if "--json" not in batch_args:
+        batch_args.insert(0, "--json")
+    run = subprocess.run(
+        [real, *batch_args, "batch"],
+        input=json.dumps([{"tool": "game", "params": params}]),
+        text=True,
+        capture_output=True,
+        check=False,
+    )
+    if run.returncode != 0:
+        _ = sys.stderr.write(run.stderr)
+        return run.returncode
+    if '"ok": false' in run.stdout or '"ok":false' in run.stdout:
+        _ = sys.stderr.write(run.stdout)
+        return 1
+    _ = sys.stdout.write(run.stdout)
+    return 0
+
+
+def split_global(args: list[str]) -> tuple[list[str], list[str]]:
+    out: list[str] = []
+    i = 0
+    while i < len(args) and args[i] in {"--json", "--ids", "--instance", "--timeout"}:
+        out.append(args[i])
+        if args[i] in {"--instance", "--timeout"}:
+            if i + 1 >= len(args):
+                fail(f"{args[i]} requires a value")
+            i += 1
+            out.append(args[i])
+        i += 1
+    return out, args[i:]
+
+
+def game_params(args: list[str]) -> dict[str, bool | float | int | str | list[str]]:
+    if not args:
+        fail("game --pid requires an action")
+    action = args[0]
+    if action in {"tree", "instances"}:
+        exact_count(args, 1)
+        return {"action": action}
+    if action == "screenshot":
+        return {"action": action, **flags(args[1:], boolean={"analyze"})}
+    if action == "input":
+        if len(args) < 2 or args[1] not in {"mouse", "key", "action", "text"}:
+            fail("game input requires mouse, key, action, or text")
+        kind = args[1]
+        if kind == "text":
+            exact_count(args, 3)
+            return {"action": "input", "kind": kind, "text": args[2]}
+        positional: dict[str, bool | float | int | str | list[str]] = {"action": "input", "kind": kind}
+        rest = args[2:]
+        if kind == "action":
+            if not rest or rest[0].startswith("--"):
+                fail("game input action requires a name")
+            positional["name"] = rest[0]
+            rest = rest[1:]
+        return {**positional, **flags(rest, modes={"press", "release", "click", "move"}, boolean={"double", "physical"})}
+    if action == "click":
+        return {"action": action, **flags(args[1:])}
+    if action == "input-log":
+        return {"action": "input_log", **flags(args[1:], boolean={"clear"})}
+    if action == "assert":
+        if len(args) not in {4, 5}:
+            fail("game assert requires path, property, operator, and optional value")
+        params: dict[str, bool | float | int | str | list[str]] = {
+            "action": "assert", "path": args[1], "prop": args[2], "op": args[3]
+        }
+        if len(args) == 5:
+            params["value"] = args[4]
+        return params
+    if action == "ui" and len(args) >= 2 and args[1] == "tree":
+        return {"action": "ui_tree", **flags(args[2:])}
+    if action == "node" and len(args) >= 3 and args[1] in {"get", "set", "call"}:
+        operation = args[1]
+        params = {"action": operation, "path": args[2]}
+        rest = args[3:]
+        if operation == "call":
+            if not rest:
+                fail("game node call requires a method")
+            params["method"] = rest[0]
+            rest = rest[1:]
+        return {**params, **flags(rest, repeated={"arg"})}
+    fail(f"unsupported PID-targeted game action: {' '.join(args)}")
+
+
+def flags(
+    args: list[str], *, boolean: set[str] | None = None, modes: set[str] | None = None,
+    repeated: set[str] | None = None,
+) -> dict[str, bool | float | int | str | list[str]]:
+    booleans = boolean or set()
+    mode_names = modes or set()
+    repeated_names = repeated or set()
+    numeric = {"x", "y", "dx", "dy", "keycode", "unicode", "limit", "depth"}
+    out: dict[str, bool | float | int | str | list[str]] = {}
+    i = 0
+    while i < len(args):
+        if not args[i].startswith("--"):
+            fail(f"unexpected argument: {args[i]}")
+        name = args[i][2:].replace("-", "_")
+        if name in booleans:
+            out[name] = True
+        elif name in mode_names:
+            if "mode" in out:
+                fail("only one input mode is allowed")
+            out["mode"] = name
+        else:
+            if i + 1 >= len(args):
+                fail(f"--{name} requires a value")
+            i += 1
+            value: bool | float | int | str | list[str]
+            if name in numeric:
+                value = nonnegative_int(args[i], f"--{name}")
+            elif name == "strength":
+                value = float(args[i])
+                if not 0 <= value <= 1:
+                    fail("--strength must be between 0 and 1")
+            elif name in {"fields", "props", "modifiers"}:
+                value = [item.strip() for item in args[i].split(",") if item.strip()]
+                if not value:
+                    fail(f"--{name} requires a value")
+            elif name in repeated_names:
+                prior = out.get("args", [])
+                value = [*prior, args[i]] if isinstance(prior, list) else [args[i]]
+                name = "args"
+            else:
+                value = args[i]
+            out[name] = value
+        i += 1
+    return out
+
+
+def real_hera() -> str:
+    override = os.environ.get("HERA_REAL_BIN")
+    candidates = [Path(override)] if override else [Path.home() / ".local/bin/hera"]
+    self_path = Path(__file__).resolve()
+    for candidate in candidates:
+        if candidate.is_absolute() and candidate.resolve() != self_path and os.access(candidate, os.X_OK):
+            return str(candidate)
+    fail("set HERA_REAL_BIN to the absolute installed Hera executable")
+
+
+def positive_int(raw: str, name: str) -> int:
+    value = nonnegative_int(raw, name)
+    if value == 0:
+        fail(f"{name} must be positive")
+    return value
+
+
+def nonnegative_int(raw: str, name: str) -> int:
+    try:
+        value = int(raw)
+    except ValueError:
+        fail(f"{name} must be an integer")
+    if value < 0:
+        fail(f"{name} must be non-negative")
+    return value
+
+
+def exact_count(args: list[str], count: int) -> None:
+    if len(args) != count:
+        fail(f"{args[0]} does not accept arguments")
+
+
+def fail(message: str) -> NoReturn:
+    print(f"hera: {message}", file=sys.stderr)
+    raise SystemExit(2)
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
